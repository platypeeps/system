# Copy to $SYSTEM_TOOLS_CONFIG/satellite-stale/.env to change a default.
# Every value is optional.
#
# Hours a claimed item may show no progress (note, updated_at, pushed branch)
# before an alert.
#SD_SATELLITE_STALE_HOURS=3
# Local hours that may alert, START-END, start inclusive, end exclusive.
#SD_SATELLITE_STALE_WINDOW=7-22
# local-notify channels for the alert.
#SD_SATELLITE_STALE_CHANNELS=ntfy,email
