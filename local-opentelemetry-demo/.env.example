# Copy to $SYSTEM_TOOLS_CONFIG/opentelemetry-demo/.env and fill in.
# Sourced by opentelemetry-demo.sh whenever it exists; these values win over
# the same names exported in the shell.

# OTLP/HTTP backend the demo's collector exports logs, metrics and traces to.
# OTLP_EXPORT_URL is the exporter base URL (the collector appends /v1/traces,
# /v1/metrics and /v1/logs). OTLP_EXPORT_AUTH is the full auth header value,
# e.g. "Bearer <token>" or the raw key your backend expects.
OTLP_EXPORT_URL=https://otlp.example.test/change-me
OTLP_EXPORT_AUTH=change-me
# The header that carries OTLP_EXPORT_AUTH. Default Authorization; set apikey
# for Mezmo-style ingestion.
#OTLP_EXPORT_AUTH_HEADER=Authorization

# mcp-install: a local aura checkout's helm chart and values file.
# It also needs OPENAI_API_KEY; export that from your shell profile rather
# than copying a global key in here.
#AURA_CHART_DIR=/path/to/aura/deployment/helm/aura
#AURA_VALUES_FILE=/path/to/aura/examples/quickstart-k8s-sre/aura-values.yaml

# repo-start / repo-stop: an upstream opentelemetry-demo checkout.
#OTEL_DEMO_REPO=/path/to/opentelemetry-demo
