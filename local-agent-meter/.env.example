# Copy to <config>/agent-meter/.env to configure agent-meter.py on this machine,
# where <config> is ${SYSTEM_TOOLS_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/system}.
# An exported value wins over this file. Optional.

# The JSONL ledger each reading is appended to. Unset: <config>/agent-meter/meter.jsonl.
# Its directory must exist.
#AGENT_METER_FILE="change-me"
