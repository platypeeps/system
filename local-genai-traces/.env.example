# Copy to <config>/genai-traces/.env and fill in; <config> is
# $SYSTEM_TOOLS_CONFIG, default ~/.config/system. Every line is optional.
#
# A second OTLP/HTTP destination for every span, next to Phoenix and the raw
# file. Unset sends nothing off this machine. Run `genai-traces.sh start`
# after a change.
#TRACES_FORWARD_OTLP_ENDPOINT=https://change-me.example.test   # base URL; the collector adds /v1/traces
#TRACES_FORWARD_OTLP_HEADERS=authorization=change-me          # name=value pairs, comma-separated

# The permanent home of the raw traces: `genai-traces.sh archive` moves each
# rotated raw file here, gzipped, and deletes nothing. It must exist; on a
# share, an unmounted share skips the run.
#GENAI_TRACES_ARCHIVE_DIR=/path/to/change-me/genai-traces
