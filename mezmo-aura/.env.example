# Copy to ~/.config/system/mezmo-aura/.env (or $SYSTEM_TOOLS_CONFIG/mezmo-aura/.env)
# and fill in real values. Values already exported win over this file.
#
# config.toml reads both keys through {{ env.* }} templates.
OPENAI_API_KEY=change-me
MEZMO_SERVICE_KEY=change-me
# The aura source checkout that `install`, `server-repo` and `image` build.
AURA_REPO=change-me
# The model `aura.sh experiment` runs; the experiment config templates these in.
LLM_PROVIDER=openrouter
LLM_MODEL=change-me
LLM_API_KEY=change-me
# The Mezmo target the experiment runs against; never the shell's MEZMO_TARGET.
# Default dev. A name holding "prod" also needs `--allow-prod`.
AURA_MEZMO_TARGET=dev
# Each target's values: AURA_MEZMO_<NAME>_..., the name upper case, - as _.
# An --overlay reads them as {{ env.MEZMO_SERVICE_KEY }} and {{ env.MEZMO_MCP_URL }}.
AURA_MEZMO_DEV_SERVICE_KEY=change-me
AURA_MEZMO_DEV_MCP_URL=https://mcp.example.test/mcp
