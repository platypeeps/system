# Copy to <config>/statusline/.env. machine-setup's envs stage installs it
# from envs/<profile>/local-statusline.env, else envs/common/.
# Space-separated email=label pairs: a login listed here shows as its label
# at the end of the HUD's Tokens line; any other login shows its email.
STATUSLINE_ACCOUNT_LABELS="change-me@example.test=main change-me-too@example.test=alt"
