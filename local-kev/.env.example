# Copy to <config>/kev/.env (<config> is $SYSTEM_TOOLS_CONFIG, default
# ~/.config/system) and change what you need. Every value is optional, and an
# exported value wins over this file.

# The checkpoint to serve: a Hub id, optionally pinned with @revision, or a
# local run directory. Default: Kev-4B at its v1.0 release.
#KEV_MODEL="jaredpalmer/kev-4b@v1.0"

# The loopback port (default 8009, Kev's documented port).
#KEV_PORT="8009"

# Where `install` clones Kev, outside this repository, and from where.
#KEV_DIR="$HOME/repos/ai/kev"
#KEV_REPO_URL="https://github.com/jaredpalmer/kev.git"

# Optional bearer token. Unset leaves the loopback server open, Kev's default.
#KEV_API_KEY="change-me"

# The Hugging Face cache for the weights. Default: /Volumes/models/huggingface
# when that folder exists, else the library's own ~/.cache/huggingface.
#HF_HOME="/Volumes/models/huggingface"

# launchd label prefix; the label is <prefix>.kev. Keep it the same for every
# tool on this machine.
#SYSTEM_TOOLS_LABEL_PREFIX="local.system-tools"
