  "cards": [
    {
      "dot": "amber",
      "title": "The standard lives in one place",
      "items": [
        "The conventions are a pack document, not six copies",
        "Each repo's CLAUDE.md is laid once and then checked, never re-laid",
        "Deliberate differences are declared, with a reason, or they fail review"
      ]
    },
    {
      "dot": "emerald",
      "title": "What the gates actually decide",
      "items": [
        "review checks provenance, a Status section and build freshness",
        "checklinks resolves every relative link and in-repo path",
        "pins reads the asserted shas out of the documents each run"
      ]
    },
    {
      "dot": "rose",
      "title": "The half no script can do",
      "items": [
        "Default to refuted: a claim stands only if the source says it",
        "Check the unit, the date and the denominator, not the digits",
        "Say what you could not check \u2014 a silent gap is a defect"
      ]
    }
  ]
