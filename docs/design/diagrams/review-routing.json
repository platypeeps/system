  "cards": [
    {
      "dot": "cyan",
      "title": "The tier is decided first",
      "items": [
        "A matched category sets the starting tier",
        "A sensitive path or an oversized change raises it one step",
        "A draft pull request drops to the cheapest tier that still reviews"
      ]
    },
    {
      "dot": "emerald",
      "title": "Deterministic before probabilistic",
      "items": [
        "sd-check runs the repo's own tests, lint and build",
        "A failing check ends the review then and there",
        "No check configured is reported, not treated as a failure"
      ]
    },
    {
      "dot": "rose",
      "title": "Nothing is posted",
      "items": [
        "Findings are labelled against a severity floor locally",
        "The default floor is medium, so low findings advise",
        "Remote review is a separate, policy-selected request"
      ]
    }
  ]
