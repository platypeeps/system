        "note": "The tier is decided from paths and size, before any model is asked."
      },
      {
        "id": "run",
        "label": "Run",
        "focus": [
          "check",
          "chain",
          "checkfail"
        ],
        "note": "A failing repo check ends the review; no provider is dispatched."
      },
      {
        "id": "dispose",
        "label": "Dispose",
        "focus": [
          "findings",
          "dispose",
          "copilot"
        ],
        "note": "Findings are labelled locally. Nothing reaches GitHub from here."
      }
    ]
  },
