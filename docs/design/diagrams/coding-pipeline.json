  "cards": [
    {
      "dot": "emerald",
      "title": "Two things track one change",
      "items": [
        "A folder under docs/work holds the thinking",
        "A database row holds the status",
        "Writing the folder does not create the row"
      ]
    },
    {
      "dot": "rose",
      "title": "Where it stops",
      "items": [
        "A failing repo check is never handed to a reviewer",
        "A hard stop names its evidence and leaves the branch pushed",
        "done is reachable only through verified delivery"
      ]
    },
    {
      "dot": "cyan",
      "title": "Two separate permissions",
      "items": [
        "sd.merge_authorization gates the assistant",
        "repo.merge_policy gates the unattended runner",
        "Branch protection overrides neither"
      ]
    }
