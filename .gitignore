# macOS
.DS_Store

# Logs and captured output (folders stay tracked via .gitkeep)
*.log
**/logs/*
!**/logs/.gitkeep
*-output.txt
*.pid
.stdin.fifo

# Generated sudo no-op shim for the vendored milvus launcher
local-milvus/.sudo-shim/

# Kev's own checkout, cloned by local-kev/kev.sh install (2 GB, upstream repo)
local-kev/kev/

# Local data / state directories (folders stay tracked via .gitkeep)
**/storage/*
!**/storage/.gitkeep
**/state/*
!**/state/.gitkeep
**/volumes/*
!**/volumes/.gitkeep
**/falkordb_data/*
!**/falkordb_data/.gitkeep
**/mcp_logs/*
!**/mcp_logs/.gitkeep
.venv
# tests/check.sh: the pinned command pack and the python3 it runs
/.ci/
node_modules/
__pycache__/

# Secrets — real values live only locally; commit *.example instead
.env
*.secret
# Salted hashes of the last gh secret set pushes (scan-for-secrets refresh)
local-scan-for-secrets/.gh-secrets-state

# Backups / superseded files
*.bak*
*.old
*.old2
*.orig
# Editor swap files can hold secret-bearing buffers (.env edits)
*.swp
.*.swp
OLD/


# Generated by milvus standalone_embed.sh at start
local-milvus/embedEtcd.yaml
local-milvus/user.yaml


# Claude Code local settings
.claude/settings.local.json

# gito review output, written into whatever folder the review ran in
code-review-report.json
code-review-report.md

# Rendered design documents. Generated by `dashboard.sh docs` from
# docs/design/*.md and served from here; the sources are what is tracked.
# Same contract as a research repo's docs/dashboard/: everything in it is
# published, and nothing in it is hand-edited.
docs/dashboard/
.claude/worktrees/

# Personal config: real values live only locally; the committed *.example is the template
local-cron-jobs/notify.conf
local-dependabot/allowed-repos.conf
local-maintenance/maintenance.conf
local-maintenance/maintenance.*.conf
local-mirror-sync/mirrors*.conf
local-project-dashboard/disk.conf
local-project-dashboard/documents.conf
local-project-dashboard/home-tiles.conf
local-project-dashboard/report-families.conf
local-repo-sync/repos.*.conf
local-scan-for-secrets/scan-for-secrets.conf
local-sd-plan/repos.*.conf
local-ai-apps/profiles/*.inv
!local-ai-apps/profiles/example.inv
# LaunchAgent plists rendered from *.plist.template at install
*.plist
# machine-setup's templates are placeholders only (@LABEL@, @HOME@, @ROOT@),
# and its suite reads them.
!local-machine-setup/examples/launchagents/*.plist
!local-machine-setup/tests/fixtures/config/machine-setup/launchagents/*.plist
