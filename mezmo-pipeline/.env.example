# Copy to ~/.config/system/mezmo-pipeline/.env (or $SYSTEM_TOOLS_CONFIG/mezmo-pipeline/.env)
# and fill in real values.
#
# These IDs name pipelines that exist only on the work account, which is why
# machine-setup's doctor lists this folder in PLACEHOLDER_EXPECTED. The guard
# in lib.sh rejects them at the point of use instead.
MEZMO_PIPELINE_SERVICE_KEY=sts_change-me
MEZMO_PIPELINE_ID=00000000-0000-0000-0000-000000000000

# Required by `pipeline.sh state`
MEZMO_PIPELINE_STATE_ID=00000000-0000-0000-0000-000000000000

# Required by `pipeline.sh source webhook`
MEZMO_SOURCE_ID=00000000-0000-0000-0000-000000000000
MEZMO_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# Optional: the v3 API host. api.logdna.com is the legacy name for the same
# surface; leave this unset unless pointing at a test double.
# MEZMO_API_BASE=https://api.mezmo.com
