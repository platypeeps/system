# Copy to $SYSTEM_TOOLS_CONFIG/fluentbit/.env and fill in.
#
# Two HTTP destinations that accept json_lines POSTs. Each URL is the full
# endpoint, http[s]://host[:port]/path. Any log backend with an HTTP ingest
# endpoint works.
FLUENTBIT_EXPORT_URL_1=https://ingest.example.test/change-me-1
FLUENTBIT_EXPORT_URL_2=https://ingest.example.test/change-me-2
# The full Authorization header value for each destination, e.g.
# "Bearer <token>" or the raw key the backend expects.
FLUENTBIT_EXPORT_AUTH_1=change-me
FLUENTBIT_EXPORT_AUTH_2=change-me
