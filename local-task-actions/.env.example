# Copy to <config>/task-actions/.env (<config> is $SYSTEM_TOOLS_CONFIG, default
# ~/.config/system) and fill in real values. Exported values win.
# The Obsidian vault the server edits (default: ~/Documents/Obsidian Vault).
#OBSIDIAN_VAULT="$HOME/Documents/change-me"

# launchd label prefix; the label is <prefix>.task-actions. Keep it the same
# for every tool on this machine.
#SYSTEM_TOOLS_LABEL_PREFIX="local.system-tools"

# The loopback port the server binds (default 8766).
#TASK_ACTIONS_PORT="8766"
