# Copy to <config>/task-actions/.env (<config> is $SYSTEM_TOOLS_CONFIG, default
# ~/.config/system) and fill in real values. Exported values win.
# The Obsidian vault the server edits and the launchd label prefix
# (<prefix>.task-actions) come from <config>/shared.env, or the environment;
# see local-config-check/shared.env.example.

# The loopback port the server binds (default 8766).
#TASK_ACTIONS_PORT="8766"
