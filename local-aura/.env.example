# Copy to ~/.config/system/aura/.env (or $SYSTEM_TOOLS_CONFIG/aura/.env)
# and fill in real values. Values already exported win over this file.
#
# config.toml reads both keys through {{ env.* }} templates.
OPENAI_API_KEY=change-me
MEZMO_API_KEY=change-me
# The aura source checkout that `install`, `server-repo` and `image` build.
AURA_REPO=change-me
# The model `aura.sh experiment` runs; the experiment config templates these in.
LLM_PROVIDER=openrouter
LLM_MODEL=change-me
LLM_API_KEY=change-me
