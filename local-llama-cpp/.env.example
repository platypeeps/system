# Copy to ~/.config/system/llama-cpp/.env (or $SYSTEM_TOOLS_CONFIG/llama-cpp/.env)
# and fill in real values.
#
# Tailscale IPv4 of each node in the two-machine cluster (`tailscale ip -4`
# on that machine). Each profile's rpc peer is the other node. Needed by
# `cluster`, `peer` and `embed home|work`; other commands run without them.
LLAMA_PERSONAL_ADDR=change-me
LLAMA_WORK_ADDR=change-me

# Optional. A directory that exists only on the work machine; its existence
# selects the work profile when REPO_SYNC_PROFILE and the machine-setup state
# file are both absent.
#LLAMA_WORK_MARKER_DIR=/Users/<work-user>/repos
