# local-mirror-sync settings. Copy to <config>/mirror-sync/.env and fill in;
# <config> is $SYSTEM_TOOLS_CONFIG, default ~/.config/system.
# offsite-verify.py reads this file; exported variables win over it.

# The NAS server and share the off-machine backup root must be mounted from,
# as <server>/<share> (the device `mount` prints, minus //user@).
OFFSITE_VERIFY_EXPECTED_SHARE=change-me/Offsite

# The off-machine backup root (default /Volumes/Offsite/Backup).
# OFFSITE_VERIFY_ROOT=/Volumes/Offsite/Backup
