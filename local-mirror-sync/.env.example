# Copy to <config>/mirror-sync/.env (<config> is $SYSTEM_TOOLS_CONFIG, default
# ~/.config/system) and fill in real values. Exported values win. Only
# nas-full-copy.sh reads these; the pair lists are the *.conf.example files.

# The disk the nightly NAS copy reads, and the mounted NAS share it writes to.
# Both are required for the nas-full-copy cron job.
#NAS_COPY_SRC="/Volumes/change-me"
#NAS_COPY_DST="/Volumes/change-me-share"

# Per-file rsync logs. Default: $NAS_COPY_SRC/repo-storage/system/nas-full-copy;
# a folder inside the source is left out of the copy.
#NAS_COPY_LOG_DIR="/Volumes/change-me/logs"
