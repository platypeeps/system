# Test fixture: a neutral sd-db-backup job in the local-cron-jobs format.
# The real job is local configuration; this one has the shape the tests
# require of it. A verified snapshot to /Volumes/local, then, only if it
# succeeded, an ADDITIVE copy of /Volumes/local/Backup to the off-machine
# share, after offsite-verify's preflight. SD_DB_BACKUP_DESTINATION names a
# one-off destination and skips the mount check and the off-machine copy.
JOB_SCHEDULE="10 2 * * *"
SD_DB_BACKUP_MOUNT=""
[ -n "${SD_DB_BACKUP_DESTINATION:-}" ] || SD_DB_BACKUP_MOUNT=" --require-mount /Volumes/local"
SD_DB_BACKUP_SNAPSHOT="\"$ROOT/../local-sd-db/sd-db.sh\" backup --destination \"${SD_DB_BACKUP_DESTINATION:-/Volumes/local/Backup/sd-backups}\"$SD_DB_BACKUP_MOUNT --keep all"
SD_DB_BACKUP_NAS="\"${SD_DB_PYTHON:-python3}\" \"$HOME/repos/system/local-mirror-sync/offsite-verify.py\" --preflight-only --destination /Volumes/Offsite/Backup && MIRROR_SYNC_CONF=mirrors-nas.conf MIRROR_SYNC_ADDITIVE=1 sh \"$HOME/repos/system/local-mirror-sync/mirror-sync.sh\" sync"
JOB_COMMAND="$SD_DB_BACKUP_SNAPSHOT && $SD_DB_BACKUP_NAS"
[ -z "${SD_DB_BACKUP_DESTINATION:-}" ] || JOB_COMMAND="$SD_DB_BACKUP_SNAPSHOT"
unset SD_DB_BACKUP_MOUNT SD_DB_BACKUP_SNAPSHOT SD_DB_BACKUP_NAS
