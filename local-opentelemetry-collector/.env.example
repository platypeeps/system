# Copy to ~/.config/system/opentelemetry-collector/.env (or $SYSTEM_TOOLS_CONFIG/opentelemetry-collector/.env)
# and fill in real values.
#
# OTLP/HTTP backend the collector forwards traces and logs to. Any vendor or
# self-hosted collector that accepts OTLP/HTTP works.
#
# OTLP_EXPORT_URL is the exporter base URL (the collector appends /v1/traces
# and /v1/logs). A URL containing "undefined" usually means a failed copy out
# of a web UI; `start` rejects it.
OTLP_EXPORT_URL=https://otlp.example.com/change-me
# The full Authorization header value, e.g. "Bearer <token>" or the raw key
# your backend expects.
OTLP_EXPORT_AUTH=change-me
