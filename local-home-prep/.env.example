# Copy to <config>/home-prep/.env, where <config> is
# ${SYSTEM_TOOLS_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/system}.
# An exported value wins over this file.

# The Google account the drafts go in; the workspace MCP server must hold it.
HOME_PREP_ACCOUNT=change-me@example.com

# Space-separated repos whose items count as home, as the workflow database
# names them. Items with no repo always count. Empty: no repo counts.
HOME_PREP_REPOS="~/repos/change-me"
