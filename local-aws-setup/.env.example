# Copy to .env (gitignored). Shared across accounts; per-account settings live
# in accounts/<name>.env (see accounts/example.env.example).
#POLICY_NAME=agent-base          # managed policy name in every account
#MANAGED_TAG_KEY=claude-managed  # EC2 instances need this tag = true
#SIMULATE_PROFILE=default        # any valid login; simulate is account-agnostic
