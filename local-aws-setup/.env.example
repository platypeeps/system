# Copy to <config>/aws-setup/.env (<config> is $SYSTEM_TOOLS_CONFIG, default
# ~/.config/system). Shared across accounts; per-account settings live
# in <config>/aws-setup/accounts/<name>.env (see accounts/example.env.example).
#POLICY_NAME=agent-base          # managed policy name; an account file may override it
#MANAGED_TAG_KEY=claude-managed  # EC2 instances need this tag = true
#SIMULATE_PROFILE=default        # any valid login; simulate is account-agnostic
