{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteSsmCommandOutput",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::{{AUDIT_BUCKET}}/ssm-output/*"
    },
    {
      "Sid": "ReadOwnStagedDeployArchive",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::{{STAGING_BUCKET}}/world-simulator-deploy/{{DEPLOYMENT}}/*"
    }
  ]
}
