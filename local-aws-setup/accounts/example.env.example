# Copy to <config>/aws-setup/accounts/<name>.env (<config> is $SYSTEM_TOOLS_CONFIG,
# default ~/.config/system); <name> is what the commands take:
#   ./aws-setup.sh apply <name>
# Account ids and bucket names are not secrets, but they are internal, and the
# agent's access key never lives here (it goes to ~/.aws/credentials).
ACCOUNT_ID=123456789012
LEVEL=operator                  # readonly | operator | sandbox
ADMIN_PROFILE=change-me         # profile with IAM admin rights in this account
#AGENT_USER=agent
#AGENT_PROFILE=agent-<name>
#AGENT_REGION=us-east-1
#POLICY_NAME=agent-base          # overrides the shared one in <config>/aws-setup/.env
S3_BUCKETS="change-me-bucket-one change-me-bucket-two"

# Reproduce every supplemental managed policy during initial setup.
# Each document belongs in <name>.policies/<policy-name>.json beside this file.
# Fresh sandbox: copy accounts/provisioning-policy.json.example and replace its placeholders.
# Keep provisioning and SSM scopes in these private documents.
#EXTRA_POLICIES="agent-provisioning"

# Optional sandbox deployment: exact same-account instance role ARNs, EC2 only.
# Audit role permissions and attached consumers before enabling this grant.
#PASS_ROLE_ARNS="arn:aws:iam::123456789012:role/change-me-instance-role"
