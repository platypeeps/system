# Copy to <config>/shared.env (<config> is $SYSTEM_TOOLS_CONFIG, default
# ~/.config/system) and fill in real values. These two values were once copied
# into several tools' .env files; every tool now reads them here. An exported
# value wins over this file, and a tool's own .env still overrides it for that
# tool.

# launchd label prefix of every job and agent (default local.system-tools).
#SYSTEM_TOOLS_LABEL_PREFIX="local.system-tools"

# The Obsidian vault every tool reads (default ~/Documents/Obsidian Vault).
#OBSIDIAN_VAULT="$HOME/Documents/change-me"
