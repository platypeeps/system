# Copy to $SYSTEM_TOOLS_CONFIG/volume-probe/.env and fill in.
#
# Paths to read, separated by ':'. Name the paths launchd jobs depend on: a
# plugin root, a backup destination. A directory is listed; a file has its
# first byte read.
VOLUME_PROBE_PATHS=/Volumes/change-me/backups:/Volumes/change-me/plugin/sd-plugin.json
# Whole seconds each read may take (1-60). Keep paths x timeout under the
# health check's 30-second status bound.
#VOLUME_PROBE_TIMEOUT=5
# A command that reads one path, given as its last argument. TCC grants are
# per binary, so this asks the question for that binary instead of ls/head.
# Plain words only, no quoting; point it at a script for anything more.
#VOLUME_PROBE_READER="/opt/homebrew/bin/rsync --list-only"
