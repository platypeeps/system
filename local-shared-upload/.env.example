# Copy to <config>/shared-upload/.env (<config> is $SYSTEM_TOOLS_CONFIG,
# default ~/.config/system). An exported value wins over this file.
# Bucket names and profile names are not secrets, but they are private: keep
# them here, never in the repository. The profile's keys stay in ~/.aws.
SHARED_UPLOAD_BUCKET=change-me
SHARED_UPLOAD_REGION=us-east-1
# A profile whose only right is s3:PutObject on the bucket; its long-lived keys
# keep a link working for up to 7 days.
SHARED_UPLOAD_PROFILE=change-me
#SHARED_UPLOAD_EXPIRES=168h
#SHARED_UPLOAD_MAX_MB=500
