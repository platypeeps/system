# Copy to $SYSTEM_TOOLS_CONFIG/fseventsd/.env and keep or change the values.
#
# Resident megabytes fseventsd may hold. Apple's own footprint budget for the
# daemon is about 30 MB; 4096 is far above anything healthy and far below the
# 28770 MB of fleet sd:8557. Unset, there is nothing to check and both
# `status` and `repair` exit 3, so a machine that has not been set up here
# stays silent in the nightly sweep.
FSEVENTSD_RSS_MB=4096
# Swap megabytes in use that counts as the machine hurting. 8192 is the
# number local-health-check already uses for swap; keep them the same.
#FSEVENTSD_SWAP_MB=8192
# Hours between two TERMs, so an hourly job cannot thrash a daemon that grows
# back fast. 0 means no floor.
#FSEVENTSD_MIN_HOURS=6
