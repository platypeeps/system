# Copy to $SYSTEM_TOOLS_CONFIG/machine-setup/machine-setup.env (default
# ~/.config/system/machine-setup/machine-setup.env). machine-setup.sh sources
# it when present. Every value is optional; an unset one turns its check off
# or keeps the default. Values here are examples, not defaults.

# Vault the obsidian stage compares against <profile>.obsidian.
OBSIDIAN_VAULT="change-me: $HOME/Documents/My Vault"

# Doctor: ssh identity files under ~, any one of which counts.
MACHINE_SETUP_SSH_KEYS="change-me: .ssh/id_ed25519"

# Doctor: profiles that expect the local-n8n TLS pair in ~/.ssh/ssl/.
MACHINE_SETUP_N8N_TLS_PROFILES="change-me: laptop"

# Extra LaunchAgent label globs capture treats as this machine's own, beyond
# $SYSTEM_TOOLS_LABEL_PREFIX.* (space-separated, e.g. "com.example.*").
MACHINE_SETUP_AGENT_GLOBS=""

# Doctor: repository folders whose .env may keep placeholder values, because
# the tool rejects them at startup (space-separated folder names).
MACHINE_SETUP_PLACEHOLDER_EXPECTED=""

# The profile names, when the files in profiles/ should not decide them.
# MACHINE_SETUP_PROFILES="laptop desktop"
