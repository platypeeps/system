# /etc/sudoers.d/machine-setup-repairs: known repair commands that run as
# root with no password, each with its exact arguments and no others
# (sd:6312). The install step in local-machine-setup/README.md, "Unattended
# sudo", puts this machine's admin account for change-me and its
# `brew --prefix` for HOMEBREW_PREFIX (sd:6475), then checks it with
# visudo -cf. Install it on each machine.
change-me ALL=(root) NOPASSWD: HOMEBREW_PREFIX/bin/brew services restart tailscale
change-me ALL=(root) NOPASSWD: /sbin/pfctl -sr
