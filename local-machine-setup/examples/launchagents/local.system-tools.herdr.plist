<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- A template. The agents stage replaces @LABEL@ with the label (this
     file's name) and @HOME@ with $HOME.
     The herdr server, in place of brew services' homebrew.mxcl.herdr, which
     started herdr itself: macOS charged every session's file access to
     herdr, whose grant each herdr upgrade dropped. Apple's /bin/bash starts
     it and stays, so the check is charged to bash, whose identity does not
     change (sd:6427). The agents stage reports a loaded homebrew.mxcl.herdr
     as drift and starts this one only once that is stopped: two servers
     would contend for one socket. RunAtLoad and KeepAlive are brew's. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>@LABEL@</string>
	<!-- `; exit $?` keeps bash from exec'ing its last command. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>/opt/homebrew/opt/herdr/bin/herdr server; exit $?</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/@LABEL@.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/@LABEL@.log</string>
</dict>
</plist>
