# Copy to <config>/mezmo-jenkins/.env (default ~/.config/system/mezmo-jenkins/.env).
# The Jenkins base URL, its StrongDM *.sdm.network name.
JENKINS_URL=http://jenkins.change-me.sdm.network
# A pull request's job path; {owner}, {repo} and {pr} are filled in.
JENKINS_JOB_PATH='job/{owner}/job/{repo}/job/PR-{pr}'
