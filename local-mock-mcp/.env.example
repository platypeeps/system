# Copy to $SYSTEM_TOOLS_CONFIG/mock-mcp/.env and fill in.
# Path to the mock-mcp-service checkout (contains the Dockerfile and mock-scenarios/).
MOCK_MCP_SRC=/path/to/mock-mcp-service
# Scenario that start/restart serve when none is named.
MOCK_SCENARIO=db-pool-exhaustion
# Optional overrides.
# MOCK_MCP_PORT=9992
# MOCK_MCP_NAME=mock-mcp
# MOCK_MCP_IMAGE=mock-mcp-service
