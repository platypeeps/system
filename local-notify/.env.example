# Copy to .env (gitignored) and fill in real values.
NTFY_TOPIC=change-me
#NTFY_SERVER=https://ntfy.sh
#NTFY_TOKEN=change-me        # only for protected topics / self-hosted servers
#IMESSAGE_TO=+15551234567    # only for the imessage channel
#NOTIFY_EMAIL_TO=change-me@example.com  # the one address the email channel may mail;
                             # required for -c email. EMAIL_TO need not be set;
                             # a value that disagrees with this fails the channel.
#EMAIL_FROM=you@gmail.com    # Google account authorized in google_workspace_mcp
#WORKSPACE_MCP_URL=http://127.0.0.1:8083/mcp
#JEV_NOTIFY=0                # experimental, on unless this is 0/off/false/no/disabled: let
                             # local-jev pick the channels and the priority
                             # from the title and the message, and only when
                             # the caller passed neither -c nor -p. Every Jev
                             # call leaves the machine and carries the title
                             # and the message -- nothing else from this file
                             # -- so do not pipe secrets through notify.sh
                             # while it is on. See the README.
#JEV_TIMEOUT=5               # seconds to wait for that judgment before
                             # giving up and using the defaults
