# Copy to <config>/maintenance/maintenance.conf (<config> is $SYSTEM_TOOLS_CONFIG,
# default ~/.config/system) and edit for this machine.
# Maintenance checks every machine wants: pipe-separated directives,
# # comments allowed. A leading ~/ expands to $HOME. See maintenance.sh --help
# for the format.
#
# Machine-specific checks go in maintenance.<profile>.conf (also gitignored),
# read after this file. <profile> comes from MAINTENANCE_PROFILE or
# ~/.config/machine-setup/profile.

# Keep this file to checks every machine can actually pass. A check for a
# service only one profile runs belongs in maintenance.<profile>.conf: from a
# machine that does not run it, the target is permanently missing and the
# nightly job reports the same false finding forever.

# free space on the root filesystem
disk|/|10
disk|~/|10

# Backup and shared volumes
#mount|/Volumes/change-me

# A sync client that must be running
#process|change-me|change-me sync client

# A self-signed cert — warn 30 days before expiry
#cert|~/.ssh/ssl/change-me.pem|30

# log rotation caps (MB). Only .log files directly in these locations;
# milvus volumes hold RocksDB .log DATA files and must never be listed here.
logs|~/repos/system/local-cron-jobs/logs|5
logs|~/repos/system/local-cswap/logs|10
logs|~/repos/system/network-testing/logs|5
