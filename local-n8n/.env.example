# Copy to ~/.config/system/n8n/.env (or $SYSTEM_TOOLS_CONFIG/n8n/.env)
# and fill in real values.
#
# No basic-auth vars: N8N_BASIC_AUTH_* was removed in n8n 1.x and is ignored.
# Access is gated by n8n's own owner account plus MFA (N8N_MFA_ENABLED is set
# in n8n.sh; enrol the owner in the UI), and only the webhook path is exposed
# publicly at all.
N8N_ENCRYPTION_KEY=change-me
N8N_RUNNERS_AUTH_TOKEN=change-me

# Public host[:port] for webhook URLs, no scheme — the Tailscale Funnel that
# fronts the webhook path. Required: n8n.sh exits 78 without it.
N8N_PUBLIC_HOST=change-me

# Optional. Host[:port] for the editor/REST base URL — tailnet or loopback,
# never the public funnel host (that host serves no /rest, so the UI would
# break). Defaults to localhost:5678.
#N8N_EDITOR_HOST=localhost:5678

# Optional. Webhook path prefix, default `webhook`. Setting an unguessable
# value makes path-guessing useless, but changes every webhook URL — anything
# already registered with a third party must be re-registered.
#N8N_ENDPOINT_WEBHOOK=webhook
