# scan-for-secrets per-user settings. Copy to scan-for-secrets.conf
# (gitignored) beside the script, or point S4S_CONF at another file.
# Sourced as POSIX shell. Both settings ADD to the built-in generic defaults.

# More sanctioned local secrets files, skipped unless -a/--all.
# Space-separated globs, e.g. per-environment env files.
S4S_EXTRA_SECRETS_GLOBS=".env.example-prod .env.example-staging"

# Third-party checkouts and test fixtures under $HOME, skipped in critical
# mode only. One path per line, relative to $HOME; ** globs allowed.
# Rule for adding: not your remote AND no local files of yours inside.
S4S_EXTRA_CRITICAL_EXCLUDE_PATHS="
repos/ai/llama.cpp
repos/ai/python-sdk
repos/example-org/vendored-fixtures/tests
"
