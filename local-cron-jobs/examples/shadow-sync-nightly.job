# Read-only GitHub collection into local shadow rows, every hour at :20
# local time. Working hours keep the rows fresh (sd:6750); the night runs
# too, so the pr-attention read clears a merged PR's alert within the hour
# (sd:8111). The name keeps "nightly": the hub-only agent list, the
# promote role jobs and installed machines know the job by it. Collection
# errors retain the old watermark; cron's failure channel reports a
# nonzero exit.
# `sd shadow sync` waits about a minute for the database lock. A run still
# locked out after that retries up to SHADOW_SYNC_RETRIES times (default
# 4), SHADOW_SYNC_RETRY_WAIT seconds apart (default 120): about 10 minutes
# in all, as one 120 s retry still lost to long writers (sd:8437,
# sd:8550). Any other failure fails at once.
# The command is single-quoted so the `bash -c` that runs it reads
# SD_PACK_ROOT after ~/.config/shell/env.sh; this file is sourced first.
JOB_SCHEDULE="20 * * * *"
JOB_COMMAND='sd="${SD_PACK_ROOT:-$HOME/repos/platypeeps/sd-workflow}/bin/sd"
pause=${SHADOW_SYNC_RETRY_WAIT:-120} left=${SHADOW_SYNC_RETRIES:-4}
while :; do
  out=$("$sd" shadow sync --strict 2>&1); rc=$?
  printf "%s\n" "$out"
  case "$rc:$out" in
    0:*) exit 0 ;;
    *"database is locked"*) [ "$left" -gt 0 ] || exit "$rc" ;;
    *) exit "$rc" ;;
  esac
  echo "shadow sync: database is locked; retry in ${pause}s, ${left} left"
  left=$((left - 1))
  sleep "$pause"
done'
