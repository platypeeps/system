# Nightly read-only GitHub collection into local shadow rows. Collection errors
# retain the old watermark; cron's failure channel reports a nonzero exit.
# SD_PACK_ROOT is escaped so the `bash -c` that runs the command reads it,
# after ~/.config/shell/env.sh; this file is sourced before env.sh is.
JOB_SCHEDULE="20 2 * * *"
JOB_COMMAND="\"\${SD_PACK_ROOT:-\$HOME/repos/platypeeps/sd-ai-command-pack}/bin/sd\" shadow sync --strict"
