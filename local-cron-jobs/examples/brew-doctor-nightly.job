# Nightly brew doctor: auto-fix safe issues (cleanup, relink), and report
# anything needing a decision (deprecations, untrusted taps) with an
# SD_REPORT_ATTENTION line, so the run's report reaches Reports and Today.
JOB_SCHEDULE="15 2 * * *"
JOB_COMMAND="sh \"$ROOT/../local-brew-doctor/brew-doctor.sh\" run"
