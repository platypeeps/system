# Copy to <config>/cron-jobs/.env to configure cron-jobs.sh on this machine,
# where <config> is ${SYSTEM_TOOLS_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/system}.
# cron-jobs.sh reads .env on every call, including the runs launchd starts,
# so keep these here rather than only in a login shell. A value already
# exported in the environment wins over this file. All are optional.

# Colon-separated extra job directories, searched before
# <config>/cron-jobs/jobs. A job there overrides a same-named job in the
# config directory. Use it for a schedule kept in another repository.
#CRON_JOBS_EXTRA_DIRS="change-me"

# launchd label prefix; labels are <prefix>.cron.<job>.
#SYSTEM_TOOLS_LABEL_PREFIX="local.system-tools"
