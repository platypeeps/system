# Copy to .env (gitignored) to configure cron-jobs.sh on this machine.
# cron-jobs.sh reads .env on every call, including the runs launchd starts,
# so keep these here rather than only in a login shell. A value already
# exported in the environment wins over this file. All are optional.

# Colon-separated extra job directories, searched before ./jobs. A job there
# overrides a same-named job in ./jobs. Use it for a private schedule kept in
# another repository.
CRON_JOBS_EXTRA_DIRS="change-me"

# Directory with common.cron and <profile>.cron manifests, which choose the
# jobs `install --all` and `verify --all` act on. Unset: every defined job.
#CRON_JOBS_PROFILES_DIR="change-me"

# launchd label prefix; labels are <prefix>.cron.<job>.
#SYSTEM_TOOLS_LABEL_PREFIX="local.system-tools"
