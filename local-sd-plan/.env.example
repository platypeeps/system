# Copy to <config>/sd-plan/.env; <config> is $SYSTEM_TOOLS_CONFIG, default
# ~/.config/system. Every value is optional.
#
# `sd-plan.sh item` sources this file. A run from the queue needs it: the
# runner gives that run a fixed environment with HOME and no SD_* exports,
# so a value exported in a shell never reaches it.
#SD_PLAN_CLAUDE=change-me      # the agent binary, when not ~/.local/bin/claude
#SD_PACK_ROOT=change-me        # the pack checkout, when not ~/repos/platypeeps/sd-ai-command-pack
#SD_PLAN_PYTHON=change-me      # an interpreter 3.13 or newer with sd_db installed
