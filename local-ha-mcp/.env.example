# Copy to ~/.config/system/ha-mcp/.env (or $SYSTEM_TOOLS_CONFIG/ha-mcp/.env)
# and fill in real values.
# Nothing here is required if the values are already exported --
# HA_TOKEN normally comes from ~/.config/shell/env.sh.
HA_TOKEN=change-me
# Required: the Home Assistant MCP SSE endpoint. Only an http URL goes
# through the loopback relay; an https one reaches the bridge as it is, and
# macOS Local Network blocking then applies to it.
HA_MCP_URL=http://change-me:8123/mcp_server/sse
#MCP_REMOTE_VERSION=0.8.3
# Optional: the Node that runs the bridge. Default: the first `node` on
# PATH. Any Node works: macOS's Local Network privacy refuses node the Home
# Assistant host (EHOSTUNREACH while curl to it returns 200), so ha-mcp.sh
# runs relay.py under Apple's /usr/bin/python3, which reaches it, and points
# the bridge at that relay on 127.0.0.1, which is never gated.
#HA_MCP_NODE=/opt/homebrew/bin/node
