# Copy to ~/.config/system/ha-mcp/.env (or $SYSTEM_TOOLS_CONFIG/ha-mcp/.env)
# and fill in real values.
# Nothing here is required if the values are already exported --
# HA_TOKEN normally comes from ~/.config/shell/env.sh.
HA_TOKEN=change-me
# Required: the Home Assistant MCP SSE endpoint.
HA_MCP_URL=http://change-me:8123/mcp_server/sse
#MCP_REMOTE_VERSION=0.8.3
# The Node that runs the bridge. Default: ~/.local/bin/node, which
# machine-setup links to fnm's nodejs.org build for a `.node` `<major> link`
# line, else the first `node` on PATH. macOS keys the Privacy > Local Network
# grant to a binary's signer: nodejs.org signs every release with one
# Developer ID, so a grant holds across upgrades, while Homebrew's ad-hoc
# signed node loses it at each rebuild and the bridge fails with
# EHOSTUNREACH while curl to the same host still returns 200. Set this only
# to run another node.
#HA_MCP_NODE=/Users/change-me/.local/bin/node
