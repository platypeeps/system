# Copy to ~/.config/system/ha-mcp/.env (or $SYSTEM_TOOLS_CONFIG/ha-mcp/.env)
# and fill in real values.
# Nothing here is required if the values are already exported --
# HA_TOKEN normally comes from ~/.config/shell/env.sh.
HA_TOKEN=change-me
# Required: the Home Assistant MCP SSE endpoint.
HA_MCP_URL=http://change-me:8123/mcp_server/sse
#MCP_REMOTE_VERSION=0.8.3
# Pin the Node that runs the bridge. Default: first `node` on PATH. Worth
# setting on a machine with more than one Node -- e.g. Homebrew `node` and
# the keg-only `node@22`, each ad-hoc signed with its own identifier and so
# tracked as a separate entry in Privacy > Local Network. Home Assistant is a
# same-link peer, which that permission gates, so a silent Node swap shows up
# as EHOSTUNREACH while curl to the same host still returns 200.
#HA_MCP_NODE=/opt/homebrew/opt/node@22/bin/node
