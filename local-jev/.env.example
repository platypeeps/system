# Copy to <config>/jev/.env and fill in real values; <config> is
# $SYSTEM_TOOLS_CONFIG, default ~/.config/system.
#
# On a machine where ~/.config/shell/env.sh already exports TYPESAFE_API_KEY
# this file is not needed at all: the exported value wins over everything here.
TYPESAFE_API_KEY=change-me
#JEV_URL=https://api.typesafe.ai/v1/systemone
#JEV_MODEL=jev-latest        # or a pinned build, e.g. jev-1.13.0
#JEV_TIMEOUT=30              # seconds per attempt
#JEV_RETRIES=3               # retries for 429/529/5xx, doubling backoff
#JEV_TRACES_URL=http://127.0.0.1:4338/v1/traces   # local-genai-traces; unset sends nothing
#JEV_CORPUS=0               # store no trace corpus; unset means on
#JEV_CORPUS_DIR=            # default ~/.local/share/sd/jev-corpus; keep it on the system disk
#JEV_CORPUS_DAYS=30         # UTC days of corpus files kept before today's

# --- Comparison arms (jev_compare.py) ------------------------------------------
# Opt-in: no arm runs until a stage is listed here. A listed stage's live
# calls that reach Jev also send the same redacted request to the Kev arm,
# and to the Haiku arm when a transport is named, in a detached child; the
# ledger records one row per arm. See README.md, "The comparison arms".
#JEV_COMPARE_STAGES=JEV_SD_REVIEW   # stage names separated by commas; start local-kev first
#JEV_COMPARE_KEV_URL=http://127.0.0.1:8009/v1/systemone
#KEV_API_KEY=change-me       # only if local-kev runs with a bearer token
#KEV_MODEL=jaredpalmer/kev-4b@v1.0   # recorded as the Kev row's model

# anthropic, openrouter, claude-cli or baseten turns the Haiku arm on.
#JEV_COMPARE_HAIKU_VIA=anthropic
#JEV_COMPARE_HAIKU_MODEL=claude-haiku-4-5   # per-transport default otherwise
# A jev-only key: the shell profile unsets ANTHROPIC_API_KEY on purpose.
# Set here, a key reaches every caller; in env.sh, only shells started after it.
#JEV_COMPARE_ANTHROPIC_KEY=change-me
#JEV_COMPARE_OPENROUTER_KEY=change-me       # or OPENROUTER_API_KEY
#JEV_COMPARE_BASETEN_KEY=change-me          # or BASETEN_API_KEY
#JEV_COMPARE_BASETEN_MODEL=change-me        # required: Baseten serves no Haiku
#JEV_COMPARE_CLAUDE=claude                  # the claude CLI for claude-cli
# US dollars per million tokens, for a transport that reports no cost.
# Default: Haiku 4.5's list price (1 and 5) for the transport's own Haiku model.
# Baseten, or a JEV_COMPARE_HAIKU_MODEL naming another model, has no default.
#JEV_COMPARE_HAIKU_USD_IN=1
#JEV_COMPARE_HAIKU_USD_OUT=5
#JEV_COMPARE_TIMEOUT=60      # seconds the child gives each arm
#JEV_COMPARE_LOG=            # a file for the child's stderr; unset discards it
