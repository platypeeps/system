# Copy to .env (gitignored) and fill in real values.
#
# On a machine where ~/.config/shell/env.sh already exports TYPESAFE_API_KEY
# this file is not needed at all: the exported value wins over everything here.
TYPESAFE_API_KEY=change-me
#JEV_URL=https://api.typesafe.ai/v1/systemone
#JEV_MODEL=jev-latest        # or a pinned build, e.g. jev-1.13.0
#JEV_TIMEOUT=30              # seconds per attempt
#JEV_RETRIES=3               # retries for 429/529/5xx, doubling backoff
