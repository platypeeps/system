# Host presets for network-testing.sh and thunderbolt-bridge.sh.
# Copy to hosts.conf (gitignored) and replace the example addresses, or point
# NETWORK_TESTING_HOSTS at another file. One record per line; `#` comments.
#
#   client <preset> <ip> [<bind-ip>]   iperf3 client target; bind-ip is the
#                                      local address to send from (-B)
#   bridge <name> <ip>                 a machine's Thunderbolt bridge address:
#                                      `server-tb <name>` binds it and
#                                      `thunderbolt-bridge.sh <name>` assigns it
#   ping <name> <ip>                   named `ping` target (e.g. gateway, dns)
#
# The addresses below are documentation ranges (RFC 5737); replace them.

client  host-a       192.0.2.10
client  host-a-tb    198.51.100.10  198.51.100.11
client  host-b       192.0.2.20
client  host-b-tb    198.51.100.11  198.51.100.10
client  host-b-wifi  192.0.2.21
client  nas          192.0.2.30

bridge  host-a       198.51.100.10
bridge  host-b       198.51.100.11

ping    gateway      192.0.2.1
ping    dns          192.0.2.53
